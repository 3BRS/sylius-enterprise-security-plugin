<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		   xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

	<services>
		<defaults public="true"/>

		<service id="three_brs.behat.context.ui.shop.password_policy"
				 class="Tests\ThreeBRS\SyliusEnterpriseSecurityPlugin\Behat\Context\Ui\Shop\PasswordPolicyContext">
			<argument type="service" id="behat.mink.default_session"/>
		</service>

		<service id="three_brs.behat.context.ui.admin.password_policy"
				 class="Tests\ThreeBRS\SyliusEnterpriseSecurityPlugin\Behat\Context\Ui\Admin\PasswordPolicyContext">
			<argument type="service" id="behat.mink.default_session"/>
		</service>

		<service id="three_brs.behat.context.ui.shop.change_password_policy"
				 class="Tests\ThreeBRS\SyliusEnterpriseSecurityPlugin\Behat\Context\Ui\Shop\ChangePasswordPolicyContext">
			<argument type="service" id="behat.mink.default_session"/>
		</service>

		<service id="three_brs.behat.context.ui.admin.customer_password_policy"
				 class="Tests\ThreeBRS\SyliusEnterpriseSecurityPlugin\Behat\Context\Ui\Admin\CustomerPasswordPolicyContext">
			<argument type="service" id="behat.mink.default_session"/>
			<argument type="service" id="sylius.repository.customer"/>
		</service>

		<service id="three_brs.behat.context.ui.shop.password_history"
				 class="Tests\ThreeBRS\SyliusEnterpriseSecurityPlugin\Behat\Context\Ui\Shop\PasswordHistoryContext">
			<argument type="service" id="behat.mink.default_session"/>
			<argument type="service" id="sylius.repository.customer"/>
			<argument type="service" id="doctrine.orm.entity_manager"/>
		</service>

		<service id="three_brs.behat.context.ui.shop.password_expiration"
				 class="Tests\ThreeBRS\SyliusEnterpriseSecurityPlugin\Behat\Context\Ui\Shop\PasswordExpirationContext">
			<argument type="service" id="behat.mink.default_session"/>
			<argument type="service" id="sylius.repository.customer"/>
			<argument type="service" id="doctrine.orm.entity_manager"/>
		</service>

		<service id="three_brs.behat.context.ui.admin.password_history"
				 class="Tests\ThreeBRS\SyliusEnterpriseSecurityPlugin\Behat\Context\Ui\Admin\PasswordHistoryContext">
			<argument type="service" id="behat.mink.default_session"/>
			<argument type="service" id="sylius.repository.admin_user"/>
			<argument type="service" id="doctrine.orm.entity_manager"/>
		</service>

		<service id="three_brs.behat.context.ui.admin.password_expiration"
				 class="Tests\ThreeBRS\SyliusEnterpriseSecurityPlugin\Behat\Context\Ui\Admin\PasswordExpirationContext">
			<argument type="service" id="behat.mink.default_session"/>
			<argument type="service" id="sylius.repository.admin_user"/>
			<argument type="service" id="doctrine.orm.entity_manager"/>
			<argument type="service" id="router"/>
			<argument type="service" id="sylius.behat.shared_storage"/>
		</service>

		<service id="three_brs.behat.context.ui.shop.password_change_notification"
				 class="Tests\ThreeBRS\SyliusEnterpriseSecurityPlugin\Behat\Context\Ui\Shop\PasswordChangeNotificationContext">
			<argument type="service" id="sylius.email_sender"/>
			<argument type="service" id="sylius.repository.customer"/>
			<argument type="service" id="sylius.security.password_updater"/>
			<argument type="service" id="doctrine.orm.entity_manager"/>
			<argument type="service" id="behat.mink.default_session"/>
			<argument type="service" id="router"/>
			<argument type="service" id="sylius.repository.shop_user"/>
		</service>

		<service id="three_brs.behat.context.ui.admin.password_change_notification"
				 class="Tests\ThreeBRS\SyliusEnterpriseSecurityPlugin\Behat\Context\Ui\Admin\PasswordChangeNotificationContext">
			<argument type="service" id="sylius.email_sender"/>
			<argument type="service" id="sylius.repository.admin_user"/>
			<argument type="service" id="sylius.security.password_updater"/>
			<argument type="service" id="doctrine.orm.entity_manager"/>
			<argument type="service" id="behat.mink.default_session"/>
			<argument type="service" id="router"/>
		</service>
	</services>
</container>
