<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		   xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

	<services>
		<defaults public="true"/>

		<service id="three_brs.behat.context.ui.shop.password_policy"
				 class="Tests\ThreeBRS\SyliusEnterpriseSecurityPlugin\Behat\Context\Ui\Shop\PasswordPolicyContext">
			<argument type="service" id="behat.mink.default_session"/>
		</service>

		<service id="three_brs.behat.context.ui.admin.password_policy"
				 class="Tests\ThreeBRS\SyliusEnterpriseSecurityPlugin\Behat\Context\Ui\Admin\PasswordPolicyContext">
			<argument type="service" id="behat.mink.default_session"/>
		</service>

		<service id="three_brs.behat.context.ui.shop.change_password_policy"
				 class="Tests\ThreeBRS\SyliusEnterpriseSecurityPlugin\Behat\Context\Ui\Shop\ChangePasswordPolicyContext">
			<argument type="service" id="behat.mink.default_session"/>
		</service>

		<service id="three_brs.behat.context.ui.admin.customer_password_policy"
				 class="Tests\ThreeBRS\SyliusEnterpriseSecurityPlugin\Behat\Context\Ui\Admin\CustomerPasswordPolicyContext">
			<argument type="service" id="behat.mink.default_session"/>
			<argument type="service" id="sylius.repository.customer"/>
		</service>
	</services>
</container>
