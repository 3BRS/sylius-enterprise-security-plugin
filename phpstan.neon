includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-webmozart-assert/extension.neon

parameters:
    level: 8
    reportUnmatchedIgnoredErrors: false

    paths:
        - src

    excludePaths:
        - tests/Application/var/*
        - tests/Application/node_modules/*

    ignoreErrors:
        -
            identifier: trait.unused
        -
            # False positive on lowest phpstan-symfony (2.0.3): NodeBuilder generics not fully stubbed.
            # NodeBuilder::arrayNode() exists at runtime — code is correct.
            identifier: class.notFound
            path: src/DependencyInjection/Configuration.php
        -
            # Same root cause: ArrayNodeDefinition generic TParent not resolved on lowest phpstan-symfony.
            identifier: missingType.generics
            path: src/DependencyInjection/Configuration.php

    symfony:
        containerXmlPath: tests/Application/var/cache/test/Tests_ThreeBRS_SyliusEnterpriseSecurityPlugin_KernelTestDebugContainer.xml
