includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-webmozart-assert/extension.neon

parameters:
    level: 8
    reportUnmatchedIgnoredErrors: false

    paths:
        - src

    excludePaths:
        - tests/Application/var/*
        - tests/Application/node_modules/*

    ignoreErrors:
        -
            identifier: trait.unused
        -
            # False positive on lowest phpstan-symfony (2.0.3): NodeBuilder generics not fully stubbed.
            # NodeBuilder::arrayNode() exists at runtime — code is correct.
            identifier: class.notFound
            paths:
                - src/DependencyInjection/Configuration.php
                - src/Fixture/PasswordHistoryFixture.php
                - src/Fixture/PasswordExpirationFixture.php
                - src/Fixture/TwoFactorFixture.php
                - src/Fixture/SocialAccountLinkFixture.php
                - src/Fixture/MagicLinkFixture.php
                - src/Fixture/PasskeyFixture.php
                - src/Fixture/LockoutFixture.php
                - src/Fixture/SessionFixture.php
                - src/Fixture/SecuritySettingsFixture.php
                - src/Fixture/AccountDeletionFixture.php
                - src/Fixture/IpWhitelistFixture.php
                - src/Fixture/CustomerSecurityStatesFixture.php
                - src/Fixture/PasswordLoginControlFixture.php
        -
            # Same root cause: ArrayNodeDefinition generic TParent not resolved on lowest phpstan-symfony.
            identifier: missingType.generics
            paths:
                - src/DependencyInjection/Configuration.php
                - src/Fixture/PasswordHistoryFixture.php
                - src/Fixture/PasswordExpirationFixture.php
                - src/Fixture/TwoFactorFixture.php
                - src/Fixture/SocialAccountLinkFixture.php
                - src/Fixture/MagicLinkFixture.php
                - src/Fixture/PasskeyFixture.php
                - src/Fixture/LockoutFixture.php
                - src/Fixture/SessionFixture.php
                - src/Fixture/SecuritySettingsFixture.php
                - src/Fixture/AccountDeletionFixture.php
                - src/Fixture/IpWhitelistFixture.php
                - src/Fixture/CustomerSecurityStatesFixture.php
                - src/Fixture/PasswordLoginControlFixture.php

    doctrine:
        objectManagerLoader: tests/phpstan_object_manager.php

    symfony:
        containerXmlPath: tests/Application/var/cache/test/Tests_ThreeBRS_SyliusEnterpriseSecurityPlugin_KernelTestDebugContainer.xml
