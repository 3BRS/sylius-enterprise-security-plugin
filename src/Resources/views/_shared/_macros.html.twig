{#
 # Shared confirmation modal macro for actions that need user confirmation
 # (passkey delete, session revoke, social account unlink, ...).
 #
 # Renders a Bootstrap 5 modal containing a CSRF-protected POST form. A
 # trigger button in the parent template opens the modal via
 # data-bs-toggle="modal" data-bs-target="#<modal_id>".
 #
 # @param modal_id            Unique HTML id (matches trigger's data-bs-target).
 # @param title               Already-translated modal title.
 # @param body                Already-translated modal body text (the confirm question).
 # @param action_url          Form POST target URL.
 # @param csrf_id             CSRF token id (passed to twig csrf_token() function).
 # @param confirm_label       Already-translated confirm button label.
 # @param confirm_btn_class   Bootstrap btn-* class for confirm button (e.g. 'btn-danger').
 # @param test_attr           Optional raw data-test-* attribute string for the submit button.
 #}
{% macro confirmation_modal(modal_id, title, body, action_url, csrf_id, confirm_label, confirm_btn_class, test_attr = '') %}
    <div class="modal fade" id="{{ modal_id }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5">{{ title }}</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">{{ body }}</p>
                </div>
                <div class="modal-footer">
                    <form method="POST" action="{{ action_url }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrf_id) }}">
                        <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">
                            {{ 'three_brs.ui.cancel'|trans }}
                        </button>
                        <button type="submit" class="btn {{ confirm_btn_class }}"
                                data-test-three-brs-modal-confirm="{{ modal_id }}"
                                {{ test_attr|raw }}>
                            {{ confirm_label }}
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}
