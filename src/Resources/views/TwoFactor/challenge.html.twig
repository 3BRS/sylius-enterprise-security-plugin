{#
 # One template serves both firewalls, and the route it was reached through is what
 # tells them apart. The URL cannot: Sylius takes the admin path from
 # SYLIUS_ADMIN_ROUTING_PATH_NAME, so an installation that renamed it would render the
 # storefront layout on the administrator's gate and send the recovery-code link to the
 # shop controller, which serves customers only.
 #}
{% set is_admin = app.request.attributes.get('_route') == 'three_brs_admin_two_factor_challenge' %}
{% extends is_admin ? '@SyliusAdmin/shared/layout/base.html.twig' : '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'three_brs.ui.two_factor.challenge_title'|trans }} | {{ parent() }}{% endblock %}

{% block body_class %}d-flex flex-column{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-center min-vh-100 py-4">
        <div class="container" style="max-width: 30rem;">
            <div class="card shadow-sm" data-test-two-factor-challenge>
                <div class="card-body p-4">
                    <h2 class="h2 text-center mb-4">{{ 'three_brs.ui.two_factor.challenge_title'|trans }}</h2>

                    {% if authenticationError %}
                        <div class="alert alert-danger text-center" data-test-two-factor-error>
                            {{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}
                        </div>
                    {% endif %}

                    <form action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" method="post">
                        <div class="mb-3 text-center">
                            <label for="_auth_code" class="form-label">{{ 'three_brs.ui.two_factor.code'|trans }}</label>
                            <input
                                id="_auth_code"
                                type="text"
                                class="form-control form-control-lg text-center font-monospace"
                                style="letter-spacing: 0.25em; font-size: 1.75rem; font-weight: 600; width: 16rem; margin-left: auto; margin-right: auto; display: block;"
                                name="{{ authCodeParameterName }}"
                                data-test-two-factor-auth-code
                                data-totp-code
                                autocomplete="one-time-code"
                                inputmode="numeric"
                                pattern="[0-9-]*"
                                maxlength="7"
                                placeholder="XXX-XXX"
                                autofocus
                            />
                        </div>

                        {% if displayTrustedOption %}
                            <div class="form-check mb-3 d-flex justify-content-center">
                                <input id="_trusted" type="checkbox" class="form-check-input" name="{{ trustedParameterName }}" data-test-two-factor-trusted>
                                <label class="form-check-label ms-2" for="_trusted">
                                    {{ 'three_brs.ui.two_factor.trust_device'|trans }}
                                </label>
                            </div>
                        {% endif %}

                        {% if isCsrfProtectionEnabled %}
                            <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
                        {% endif %}

                        <div class="text-center">
                            <button type="submit" class="btn btn-primary" data-test-two-factor-submit>
                                {{ 'three_brs.ui.two_factor.verify'|trans }}
                            </button>
                        </div>
                    </form>

                    {% set recovery_path = is_admin ? path('three_brs_admin_two_factor_recovery_challenge') : path('three_brs_shop_two_factor_recovery_challenge') %}
                    <div class="text-center mt-4">
                        <a href="{{ recovery_path }}" data-test-two-factor-use-recovery-code>
                            {{ 'three_brs.ui.two_factor.use_recovery_code'|trans }}
                        </a>
                    </div>
                    <div class="text-center mt-2">
                        <a href="{{ logoutPath }}" class="text-muted" data-test-two-factor-cancel>
                            {{ 'three_brs.ui.two_factor.cancel'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="{{ asset('bundles/threebrssyliusenterprisesecurityplugin/js/totp_input.js') }}"></script>
{% endblock %}
