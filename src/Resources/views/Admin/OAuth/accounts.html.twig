{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% from '@SyliusAdmin/shared/helper/breadcrumbs.html.twig' import breadcrumbs %}
{% import '@SyliusAdmin/shared/helper/header.html.twig' as header %}
{% import '@ThreeBRSSyliusEnterpriseSecurityPlugin/_shared/_macros.html.twig' as shared %}

{% block title %}{{ parent() }} | {{ 'three_brs.ui.social_login.menu_item'|trans }}{% endblock %}

{% block body %}
    {% include '@SyliusAdmin/shared/crud/common/sidebar.html.twig' %}

    <div class="page-wrapper">
        {% include '@SyliusAdmin/shared/crud/common/navbar.html.twig' %}

        {% set user = app.user %}
        {% set links = user is not null ? three_brs_admin_social_links(user) : [] %}
        {% set providers = three_brs_social_providers('admin') %}
        {% set linkable = providers|filter(p => links|filter(l => l.provider == p)|length == 0) %}

        <div class="page-header" data-sticky-header>
            <div class="container-xl">
                {{ breadcrumbs([
                    { name: 'sylius.ui.dashboard', url: path('sylius_admin_dashboard'), active: false },
                    { name: 'sylius.menu.admin.main.configuration.admin_users', url: path('sylius_admin_admin_user_index'), active: false },
                    { name: app.user.id, url: path('sylius_admin_admin_user_update', {'id': app.user.id}), active: false },
                    { name: 'sylius.ui.edit', url: path('sylius_admin_admin_user_update', {'id': app.user.id}), active: false },
                    { name: 'three_brs.ui.social_login.menu_item', active: true },
                ]) }}
                <div class="row mt-3 row-gap-2 align-items-center">
                    <div class="col-12 col-md">
                        {{ header.h1('three_brs.ui.social_login.linked_accounts_title'|trans) }}
                    </div>
                    {% if linkable|length > 0 %}
                        <div class="col-12 col-md-auto ms-auto d-print-none">
                            <div class="btn-list">
                                <div class="dropdown">
                                    <button type="button"
                                            class="btn btn-primary dropdown-toggle d-inline-flex align-items-center justify-content-center"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            data-test-three-brs-social-create>
                                        <i class="icon ti ti-plus me-1"></i>
                                        {{ 'sylius.ui.create'|trans }}
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        {% for provider in linkable %}
                                            <li>
                                                <a class="dropdown-item"
                                                   href="{{ path('three_brs_admin_oauth_initiate', {'provider': provider, 'intent': 'link'}) }}"
                                                   data-test-three-brs-social-link="{{ provider }}">
                                                    <i class="icon ti {{ shared.provider_icon_class(provider) }} me-2"></i>
                                                    {{ ('three_brs.ui.social_login.provider.' ~ provider)|trans }}
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    {% elseif links|length > 0 %}
                        <div class="col-12 col-md-auto ms-auto d-print-none"
                             data-test-three-brs-social-all-linked>
                            <span class="text-secondary d-inline-flex align-items-center">
                                <i class="icon ti ti-check me-1"></i>
                                {{ 'three_brs.ui.social_login.all_linked'|trans }}
                            </span>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {% include '@SyliusAdmin/shared/crud/common/content/flashes.html.twig' %}

        <div class="page-body">
            <div class="container-xl">
                <div class="card" data-test-three-brs-social-links>
                    {% if links|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table">
                                <thead>
                                    <tr>
                                        <th>{{ 'three_brs.ui.social_login.provider_column'|trans }}</th>
                                        <th>{{ 'three_brs.ui.social_login.email_column'|trans }}</th>
                                        <th class="w-1"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for link in links %}
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <span class="avatar avatar-sm bg-secondary-lt me-2">
                                                        <i class="icon ti {{ shared.provider_icon_class(link.provider) }}"></i>
                                                    </span>
                                                    <span class="fw-semibold">
                                                        {{ ('three_brs.ui.social_login.provider.' ~ link.provider)|trans }}
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="text-secondary">{{ link.email ?: '—' }}</td>
                                            <td class="text-end">
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#three-brs-admin-social-unlink-modal-{{ link.provider }}"
                                                        data-test-three-brs-social-unlink="{{ link.provider }}">
                                                    {{ 'three_brs.ui.social_login.unlink'|trans }}
                                                </button>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="card-body">
                            <div class="empty py-4">
                                <div class="empty-icon">
                                    <i class="icon ti ti-link-off fs-1"></i>
                                </div>
                                <p class="empty-title">{{ 'three_brs.ui.social_login.no_links_yet'|trans }}</p>
                                <p class="empty-subtitle text-secondary">
                                    {{ 'three_brs.ui.social_login.no_links_yet_subtitle'|trans }}
                                </p>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% for link in links %}
        {{ shared.confirmation_modal(
            'three-brs-admin-social-unlink-modal-' ~ link.provider,
            'three_brs.ui.social_login.unlink'|trans,
            'three_brs.ui.social_login.unlink_confirm'|trans,
            path('three_brs_admin_social_account_unlink', {'provider': link.provider}),
            'three_brs_admin_social_unlink_' ~ link.provider,
            'three_brs.ui.social_login.unlink'|trans,
            'btn-danger',
        ) }}
    {% endfor %}
{% endblock %}
