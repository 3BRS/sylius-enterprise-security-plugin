{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% from '@SyliusAdmin/shared/helper/breadcrumbs.html.twig' import breadcrumbs %}
{% import '@SyliusAdmin/shared/helper/header.html.twig' as header %}

{% block title %}{{ parent() }} | {{ 'three_brs.ui.social_login.menu_item'|trans }}{% endblock %}

{% block body %}
    {% include '@SyliusAdmin/shared/crud/common/sidebar.html.twig' %}

    <div class="page-wrapper">
        {% include '@SyliusAdmin/shared/crud/common/navbar.html.twig' %}

        <div class="page-header" data-sticky-header>
            <div class="container-xl">
                {{ breadcrumbs([
                    { name: 'sylius.ui.dashboard', url: path('sylius_admin_dashboard'), active: false },
                    { name: 'three_brs.ui.social_login.menu_item', active: true },
                ]) }}
                <div class="row mt-3 row-gap-2">
                    <div class="col-12">
                        {{ header.h1('three_brs.ui.social_login.linked_accounts_title'|trans) }}
                    </div>
                </div>
            </div>
        </div>

        {% include '@SyliusAdmin/shared/crud/common/content/flashes.html.twig' %}

        <div class="page-body">
            <div class="container-xl">
                {% set user = app.user %}
                {% if user is not null %}
                    {% set links = three_brs_admin_social_links(user) %}
                    {% set providers = three_brs_social_providers('admin') %}
                    {% set linkable = providers|filter(p => links|filter(l => l.provider == p)|length == 0) %}

                    <div class="row g-3" data-test-three-brs-social-links>
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body">
                                    <p class="text-secondary mb-0">
                                        {{ 'three_brs.ui.social_login.admin_intro'|trans }}
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-xl-7">
                            <div class="card h-100">
                                <div class="card-header">
                                    <h3 class="card-title">{{ 'three_brs.ui.social_login.linked_accounts_title'|trans }}</h3>
                                </div>
                                <div class="card-body">
                                    {% if links|length > 0 %}
                                        <div class="list-group list-group-flush">
                                            {% for link in links %}
                                                <div class="list-group-item px-0 py-3">
                                                    <div class="row align-items-center g-3">
                                                        <div class="col-auto">
                                                            <span class="avatar avatar-md bg-secondary-lt">
                                                                <i class="icon ti ti-{{ link.provider == 'apple' ? 'brand-apple' : 'brand-google' }} fs-2"></i>
                                                            </span>
                                                        </div>
                                                        <div class="col">
                                                            <div class="fw-semibold fs-3">
                                                                {{ ('three_brs.ui.social_login.provider.' ~ link.provider)|trans }}
                                                            </div>
                                                            {% if link.email %}
                                                                <div class="text-secondary">{{ link.email }}</div>
                                                            {% endif %}
                                                        </div>
                                                        <div class="col-auto">
                                                            <form method="POST"
                                                                  action="{{ path('three_brs_admin_social_account_unlink', {'provider': link.provider}) }}"
                                                                  onsubmit="return confirm('{{ 'three_brs.ui.social_login.unlink_confirm'|trans|e('js') }}');">
                                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('three_brs_admin_social_unlink_' ~ link.provider) }}">
                                                                <button type="submit"
                                                                        class="btn btn-outline-danger"
                                                                        data-test-three-brs-social-unlink="{{ link.provider }}">
                                                                    {{ 'three_brs.ui.social_login.unlink'|trans }}
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <div class="empty py-4">
                                            <div class="empty-icon">
                                                <i class="icon ti ti-link-off fs-1"></i>
                                            </div>
                                            <p class="empty-title">{{ 'three_brs.ui.social_login.no_links_yet'|trans }}</p>
                                            <p class="empty-subtitle text-secondary">
                                                {{ 'three_brs.ui.social_login.no_links_yet_subtitle'|trans }}
                                            </p>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-xl-5">
                            <div class="card h-100">
                                <div class="card-header">
                                    <h3 class="card-title">{{ 'three_brs.ui.social_login.available_providers_title'|trans }}</h3>
                                </div>
                                <div class="card-body">
                                    {% if linkable|length > 0 %}
                                        <div class="d-flex flex-column gap-2">
                                            {% for provider in linkable %}
                                                <a href="{{ path('three_brs_admin_oauth_initiate', {'provider': provider, 'intent': 'link'}) }}"
                                                   class="btn btn-outline-primary btn-lg w-100"
                                                   data-test-three-brs-social-link="{{ provider }}">
                                                    {{ 'three_brs.ui.social_login.link_provider'|trans({'%provider%': ('three_brs.ui.social_login.provider.' ~ provider)|trans}) }}
                                                </a>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <div class="empty py-4">
                                            <div class="empty-icon">
                                                <i class="icon ti ti-check fs-1"></i>
                                            </div>
                                            <p class="empty-title">{{ 'three_brs.ui.social_login.all_linked'|trans }}</p>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
