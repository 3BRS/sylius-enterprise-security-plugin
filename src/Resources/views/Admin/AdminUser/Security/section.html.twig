{# Self-only card: an admin can only manage their own 2FA, OAuth links,
   passkeys and sessions, so hide the section unless the admin being edited
   is the currently signed-in admin. #}
{% set editedAdmin = hookable_metadata.context.resource|default(null) %}
{% if editedAdmin is not null and app.user is not null and editedAdmin.id == app.user.id %}
    <div class="card mb-3" data-test-three-brs-admin-security>
        <div class="card-header">
            <h3 class="card-title mb-0">{{ 'three_brs.ui.admin_security.title'|trans }}</h3>
        </div>
        <div class="card-body">
            <div class="d-grid gap-2">
                <a href="{{ path('three_brs_admin_two_factor_setup') }}"
                   class="btn btn-primary text-center"
                   data-test-three-brs-admin-security-two-factor>
                    <i class="icon ti ti-shield-lock me-1"></i>
                    {{ 'three_brs.ui.two_factor.menu_item'|trans }}
                </a>
                <a href="{{ path('three_brs_admin_social_accounts') }}"
                   class="btn btn-primary text-center"
                   data-test-three-brs-admin-security-social-accounts>
                    <i class="icon ti ti-user-circle me-1"></i>
                    {{ 'three_brs.ui.social_login.menu_item'|trans }}
                </a>
                <a href="{{ path('three_brs_admin_passkey_index') }}"
                   class="btn btn-primary text-center"
                   data-test-three-brs-admin-security-passkey>
                    <i class="icon ti ti-fingerprint me-1"></i>
                    {{ 'three_brs.ui.passkey.menu_item'|trans }}
                </a>
                <a href="{{ path('three_brs_admin_sessions') }}"
                   class="btn btn-primary text-center"
                   data-test-three-brs-admin-security-sessions>
                    <i class="icon ti ti-devices me-1"></i>
                    {{ 'three_brs.ui.session.menu_item'|trans }}
                </a>
            </div>
        </div>
    </div>
{% endif %}
