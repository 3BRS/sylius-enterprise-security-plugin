{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% from '@SyliusAdmin/shared/helper/breadcrumbs.html.twig' import breadcrumbs %}
{% import '@SyliusAdmin/shared/helper/header.html.twig' as header %}

{% block title %}{{ parent() }} | {{ 'three_brs.ui.ip_blacklist.title'|trans }}{% endblock %}

{% block body %}
    {% include '@SyliusAdmin/shared/crud/common/sidebar.html.twig' %}

    <div class="page-wrapper">
        {% include '@SyliusAdmin/shared/crud/common/navbar.html.twig' %}

        <div class="page-header" data-sticky-header>
            <div class="container-xl">
                {{ breadcrumbs([
                    { name: 'sylius.ui.dashboard', url: path('sylius_admin_dashboard'), active: false },
                    { name: 'three_brs.ui.ip_blacklist.title', active: true },
                ]) }}
                <div class="row mt-3 row-gap-2">
                    <div class="col-12">
                        {{ header.h1('three_brs.ui.ip_blacklist.title'|trans) }}
                    </div>
                </div>
            </div>
        </div>

        {% include '@SyliusAdmin/shared/crud/common/content/flashes.html.twig' %}

        <div class="page-body">
            <div class="container-xl">
                <div class="card mb-3">
                    <div class="card-body">
                        <p class="text-secondary mb-0">
                            {{ 'three_brs.ui.ip_blacklist.intro'|trans }}
                        </p>
                    </div>
                </div>

                <div class="card mb-3" data-test-three-brs-ip-blacklist-status>
                    <div class="card-body">
                        <p class="mb-2">
                            <strong>{{ 'three_brs.ui.ip_blacklist.feature_state'|trans }}:</strong>
                            {% if featureEnabled %}
                                <span class="badge bg-success text-white">{{ 'three_brs.ui.ip_blacklist.enabled'|trans }}</span>
                            {% else %}
                                <span class="badge bg-danger text-white">{{ 'three_brs.ui.ip_blacklist.disabled'|trans }}</span>
                            {% endif %}
                        </p>
                        <p class="mb-2">
                            <strong>{{ 'three_brs.ui.ip_blacklist.global_cidrs'|trans }}:</strong>
                            {% if globalCidrs is empty %}
                                <span>{{ 'three_brs.ui.ip_blacklist.no_global_cidrs'|trans }}</span>
                            {% else %}
                                <code>{{ globalCidrs|join(', ') }}</code>
                            {% endif %}
                        </p>
                        <p class="mb-0 small">
                            {{ 'three_brs.ui.ip_blacklist.global_cidrs_hint'|trans }}
                            <a href="{{ path('three_brs_admin_security_settings_index', {scope: 'admin'}) }}">
                                {{ 'three_brs.ui.ip_blacklist.open_security_settings'|trans }}
                            </a>
                        </p>
                    </div>
                </div>

                <div class="card">
                    <div class="card-body">
                        {% if rows|length > 0 %}
                            <div class="table-responsive">
                                <table class="table table-vcenter" data-test-three-brs-ip-blacklist-admins>
                                    <thead>
                                        <tr>
                                            <th>{{ 'three_brs.ui.ip_blacklist.username'|trans }}</th>
                                            <th>{{ 'three_brs.ui.ip_blacklist.per_admin_state'|trans }}</th>
                                            <th>{{ 'three_brs.ui.ip_blacklist.per_admin_cidrs'|trans }}</th>
                                            <th class="text-end"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for row in rows %}
                                            <tr>
                                                <td>{{ row.admin.email }}</td>
                                                <td>
                                                    {% if row.blacklist is not null and row.blacklist.enabled %}
                                                        {% if row.blacklist.cidrs|length > 0 %}
                                                            <span class="badge bg-success text-white">{{ 'three_brs.ui.ip_blacklist.enabled'|trans }}</span>
                                                        {% else %}
                                                            <span class="badge bg-orange text-white">{{ 'three_brs.ui.ip_blacklist.enabled_empty'|trans }}</span>
                                                        {% endif %}
                                                    {% else %}
                                                        <span class="badge bg-danger text-white">{{ 'three_brs.ui.ip_blacklist.disabled'|trans }}</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {% if row.blacklist is null or row.blacklist.cidrs|length == 0 %}
                                                        <span>—</span>
                                                    {% else %}
                                                        <code>{{ row.blacklist.cidrs|join(', ') }}</code>
                                                    {% endif %}
                                                </td>
                                                <td class="text-end">
                                                    <a class="btn btn-outline-primary"
                                                       href="{{ path('three_brs_admin_ip_blacklist_admin_edit', {'id': row.admin.id}) }}"
                                                       data-test-three-brs-ip-blacklist-edit="{{ row.admin.id }}">
                                                        {{ 'three_brs.ui.ip_blacklist.edit'|trans }}
                                                    </a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="empty py-4">
                                <p class="empty-title">{{ 'three_brs.ui.ip_blacklist.no_admins'|trans }}</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
