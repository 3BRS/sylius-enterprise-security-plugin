{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% from '@SyliusAdmin/shared/helper/breadcrumbs.html.twig' import breadcrumbs %}
{% import '@SyliusAdmin/shared/helper/header.html.twig' as header %}

{% block title %}{{ parent() }} | {{ 'three_brs.ui.passkey.menu_item'|trans }}{% endblock %}

{% block body %}
    {% include '@SyliusAdmin/shared/crud/common/sidebar.html.twig' %}

    <div class="page-wrapper">
        {% include '@SyliusAdmin/shared/crud/common/navbar.html.twig' %}

        <div class="page-header" data-sticky-header>
            <div class="container-xl">
                {{ breadcrumbs([
                    { name: 'sylius.ui.dashboard', url: path('sylius_admin_dashboard'), active: false },
                    { name: 'three_brs.ui.passkey.menu_item', active: true },
                ]) }}
                <div class="row mt-3 row-gap-2">
                    <div class="col-12">
                        {{ header.h1('three_brs.ui.passkey.title'|trans) }}
                        <p class="text-secondary mb-0">{{ 'three_brs.ui.passkey.intro'|trans }}</p>
                    </div>
                </div>
            </div>
        </div>

        {% include '@SyliusAdmin/shared/crud/common/content/flashes.html.twig' %}

        <div class="page-body">
            <div class="container-xl">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3 class="card-title mb-0">{{ 'three_brs.ui.passkey.your_passkeys'|trans }}</h3>
                        <button type="button"
                                class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#three-brs-passkey-create-modal"
                                id="three_brs_passkey_create_trigger">
                            {{ 'three_brs.ui.passkey.register'|trans }}
                        </button>
                    </div>
                    <div class="card-body">
                        <p id="three_brs_passkey_unsupported_notice" class="text-warning small mb-3 d-none">
                            {{ 'three_brs.ui.passkey.browser_unsupported'|trans }}
                        </p>
                        {% if credentials|length > 0 %}
                            <div class="list-group list-group-flush" data-test-three-brs-passkey-list>
                                {% for credential in credentials %}
                                    <div class="list-group-item px-0 py-3">
                                        <div class="row align-items-center g-3">
                                            <div class="col-auto">
                                                <span class="avatar avatar-md bg-secondary-lt">
                                                    <i class="icon ti ti-fingerprint fs-2"></i>
                                                </span>
                                            </div>
                                            <div class="col">
                                                <div class="fw-semibold fs-3">{{ credential.label }}</div>
                                                <div class="text-secondary small">
                                                    {{ 'three_brs.ui.passkey.added'|trans }}: {{ credential.createdAt|date('Y-m-d H:i') }}
                                                    {% if credential.lastUsedAt %}
                                                        · {{ 'three_brs.ui.passkey.last_used'|trans }}: {{ credential.lastUsedAt|date('Y-m-d H:i') }}
                                                    {% endif %}
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                                <form method="POST"
                                                      action="{{ path('three_brs_admin_passkey_delete', {'id': credential.id}) }}"
                                                      onsubmit="return confirm('{{ 'three_brs.ui.passkey.delete_confirm'|trans|e('js') }}');">
                                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('three_brs_admin_passkey_delete') }}">
                                                    <button type="submit"
                                                            class="btn btn-outline-danger"
                                                            data-test-three-brs-passkey-delete="{{ credential.id }}">
                                                        {{ 'three_brs.ui.passkey.delete'|trans }}
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="empty py-4">
                                <div class="empty-icon">
                                    <i class="icon ti ti-fingerprint-off fs-1"></i>
                                </div>
                                <p class="empty-title">{{ 'three_brs.ui.passkey.none_yet'|trans }}</p>
                                <p class="empty-subtitle text-secondary">
                                    {{ 'three_brs.ui.passkey.none_yet_subtitle'|trans }}
                                </p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="three-brs-passkey-create-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5">{{ 'three_brs.ui.passkey.name_your_passkey'|trans }}</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label for="three_brs_passkey_label_input" class="form-label">
                        {{ 'three_brs.ui.passkey.label_field_label'|trans }}
                    </label>
                    <input type="text"
                           class="form-control"
                           id="three_brs_passkey_label_input"
                           placeholder="{{ 'three_brs.ui.passkey.label_placeholder'|trans }}"
                           maxlength="64">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">
                        {{ 'three_brs.ui.passkey.cancel'|trans }}
                    </button>
                    <button type="button"
                            class="btn btn-primary"
                            id="three_brs_passkey_register_button"
                            data-test-three-brs-passkey-register
                            data-options-url="{{ path('three_brs_admin_passkey_register_options') }}"
                            data-verify-url="{{ path('three_brs_admin_passkey_register_verify') }}"
                            data-list-url="{{ path('three_brs_admin_passkey_index') }}"
                            data-cancelled-message="{{ 'three_brs.ui.passkey.registration_cancelled'|trans }}"
                            data-error-message="{{ 'three_brs.ui.passkey.registration_failed'|trans }}"
                            data-modal-target="#three-brs-passkey-create-modal">
                        {{ 'three_brs.ui.passkey.submit'|trans }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="{{ asset('bundles/threebrssyliusenterprisesecurityplugin/js/passkey.js') }}"></script>
{% endblock %}
