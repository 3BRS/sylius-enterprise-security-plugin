{% if three_brs_passkey_enabled('admin') %}
    <div class="text-center my-3">
        <button type="button"
                class="btn btn-outline-primary w-100"
                id="three_brs_passkey_login_button"
                data-test-three-brs-passkey-login
                data-options-url="{{ path('three_brs_admin_passkey_login_options') }}"
                data-verify-url="{{ path('three_brs_admin_passkey_login_verify') }}"
                data-fallback-url="{{ path('sylius_admin_dashboard') }}">
            {{ 'three_brs.ui.passkey.sign_in_with_passkey'|trans }}
        </button>
        <p id="three_brs_passkey_unsupported_notice" class="text-muted small mt-2 mb-0 d-none">
            {{ 'three_brs.ui.passkey.browser_unsupported'|trans }}
        </p>
    </div>
    <script src="{{ asset('bundles/threebrssyliusenterprisesecurity/js/passkey.js') }}"></script>
{% endif %}
