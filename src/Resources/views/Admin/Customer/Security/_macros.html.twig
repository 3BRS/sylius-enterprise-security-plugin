{#
 # Shared Bootstrap-modal macro for the customer security section.
 # Renders a trigger-less modal — the trigger button lives in the section
 # template and opens the modal via data-bs-toggle / data-bs-target.
 #}
{% macro action_modal(modal_id, title, body, action_url, csrf_id, confirm_label, confirm_btn_class) %}
    <div class="modal fade" id="{{ modal_id }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5">{{ title }}</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">{{ body }}</p>
                </div>
                <div class="modal-footer">
                    <form method="POST" action="{{ action_url }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrf_id) }}">
                        <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">
                            {{ 'three_brs.ui.customer_security.cancel'|trans }}
                        </button>
                        <button type="submit" class="btn {{ confirm_btn_class }}"
                                data-test-three-brs-customer-security-confirm="{{ modal_id }}">
                            {{ confirm_label }}
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}
