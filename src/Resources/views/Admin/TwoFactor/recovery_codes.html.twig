{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% block title %}{{ parent() }} | {{ 'three_brs.ui.two_factor.recovery_codes_title'|trans }}{% endblock %}

{% block body_class %}d-flex flex-column{% endblock %}

{% block body %}
    <div class="page page-center">
        <div class="container container-tight py-4">
            <div class="card card-md">
                <div class="card-body">
                    <h2 class="h2 text-center mb-2">{{ 'three_brs.ui.two_factor.recovery_codes_title'|trans }}</h2>
                    <p class="alert alert-warning">{{ 'three_brs.ui.two_factor.recovery_codes_warning'|trans }}</p>

                    <ul class="list-group mb-3" data-test-two-factor-recovery-codes>
                        {% for code in codes %}
                            <li class="list-group-item font-monospace" data-test-recovery-code>{{ code }}</li>
                        {% endfor %}
                    </ul>

                    <a href="{{ path('sylius_admin_dashboard') }}" class="btn btn-primary w-100">
                        {{ 'three_brs.ui.two_factor.recovery_codes_acknowledged'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
