{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% from '@SyliusAdmin/shared/helper/breadcrumbs.html.twig' import breadcrumbs %}
{% import '@SyliusAdmin/shared/helper/header.html.twig' as header %}

{% block title %}{{ parent() }} | {{ 'three_brs.ui.two_factor.setup_title'|trans }}{% endblock %}

{% block body %}
    {% include '@SyliusAdmin/shared/crud/common/sidebar.html.twig' %}

    <div class="page-wrapper">
        {% include '@SyliusAdmin/shared/crud/common/navbar.html.twig' %}

        <div class="page-header" data-sticky-header>
            <div class="container-xl">
                {{ breadcrumbs([
                    { name: 'sylius.ui.dashboard', url: path('sylius_admin_dashboard'), active: false },
                    { name: 'three_brs.ui.two_factor.menu_item', active: true },
                ]) }}
                <div class="row mt-3 row-gap-2">
                    <div class="col-12">
                        {{ header.h1('three_brs.ui.two_factor.setup_title'|trans) }}
                    </div>
                </div>
            </div>
        </div>

        <div class="page-body">
            <div class="container-xl">
                <div class="card mb-3">
                    <div class="card-body">
                        <p class="text-secondary mb-0">
                            {{ 'three_brs.ui.two_factor.setup_description'|trans }}
                        </p>
                    </div>
                </div>

                <div class="card">
                    <div class="card-body">
                        <div class="row align-items-center mb-4">
                            <div class="col-md-5 text-center mb-3 mb-md-0">
                                <img src="{{ qr_data_uri }}" alt="{{ 'three_brs.ui.two_factor.setup_title'|trans }}" class="img-fluid border rounded p-2 bg-white" data-test-two-factor-qr>
                            </div>
                            <div class="col-md-7">
                                <p class="mb-2">{{ 'three_brs.ui.two_factor.manual_code'|trans }}</p>
                                <code class="d-block p-3 bg-light border rounded text-break" data-test-two-factor-secret>{{ secret }}</code>
                            </div>
                        </div>

                        {% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}
                        {{ form_start(form, { action: path('three_brs_admin_two_factor_setup'), method: 'POST', attr: { novalidate: 'novalidate' } }) }}
                            <div class="mb-3 text-center">
                                {{ form_label(form.code) }}
                                {{ form_widget(form.code) }}
                                {{ form_errors(form.code) }}
                            </div>
                            <div class="form-footer mt-3 text-center">
                                <button type="submit" class="btn btn-primary" data-test-two-factor-verify>
                                    {{ 'three_brs.ui.two_factor.verify_and_enable'|trans }}
                                </button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            document.querySelectorAll('[data-totp-code]').forEach(function (input) {
                input.addEventListener('input', function () {
                    var digits = input.value.replace(/\D/g, '').slice(0, 6);
                    input.value = digits.length > 3 ? digits.slice(0, 3) + '-' + digits.slice(3) : digits;
                });
                var form = input.closest('form');
                if (form) {
                    form.addEventListener('submit', function () {
                        input.value = input.value.replace(/-/g, '');
                    });
                }
            });
        })();
    </script>
{% endblock %}
