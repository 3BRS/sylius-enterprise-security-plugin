{% block subject %}
    {{ 'three_brs.emails.admin_password_changed.subject'|trans }}
{% endblock %}

{% block body %}
    <div style="font-family: sans-serif; background: #eee; padding-top: 30px; padding-bottom: 30px; font-size: 16px; color: #333; line-height: 1.5">
        <div style="max-width: 600px; margin: 20px auto;">
            <div style="background: #fff; padding: 40px 30px;">
                <div style="font-size: 24px; margin-bottom: 20px;">
                    {{ 'three_brs.emails.admin_password_changed.title'|trans }}
                </div>

                <p>{{ 'three_brs.emails.password_changed.intro'|trans }}</p>

                <table style="width: 100%; border-collapse: collapse; margin: 20px 0;">
                    <tr>
                        <td style="padding: 8px; border-bottom: 1px solid #eee; color: #666;">{{ 'three_brs.emails.password_changed.timestamp'|trans }}</td>
                        <td style="padding: 8px; border-bottom: 1px solid #eee;">{{ timestamp|date('Y-m-d H:i:s', 'UTC') }} UTC</td>
                    </tr>
                    {% if ipAddress %}
                    <tr>
                        <td style="padding: 8px; border-bottom: 1px solid #eee; color: #666;">{{ 'three_brs.emails.password_changed.ip_address'|trans }}</td>
                        <td style="padding: 8px; border-bottom: 1px solid #eee;">{{ ipAddress }}</td>
                    </tr>
                    {% endif %}
                    {% if userAgent %}
                    <tr>
                        <td style="padding: 8px; border-bottom: 1px solid #eee; color: #666;">{{ 'three_brs.emails.password_changed.device'|trans }}</td>
                        <td style="padding: 8px; border-bottom: 1px solid #eee;">{{ userAgent }}</td>
                    </tr>
                    {% endif %}
                </table>

                {% if not initiatedByUser %}
                    <div style="background: #fff3cd; border: 1px solid #ffc107; padding: 15px; border-radius: 4px; margin-top: 20px;">
                        <strong>{{ 'three_brs.emails.password_changed.not_you_warning'|trans }}</strong>
                    </div>
                    {% if secureAccountUrl %}
                        <div style="text-align: center; margin-top: 20px;">
                            <a href="{{ secureAccountUrl }}" style="display: inline-block; background: #dc3545; padding: 14px 24px; color: #fff; text-decoration: none; border-radius: 4px;">
                                {{ 'three_brs.emails.password_changed.secure_account'|trans }}
                            </a>
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
