{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'three_brs.ui.social_login.confirm_link_title'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container mb-auto">
        <div class="row my-4 justify-content-center">
            <div class="col-12 col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h1 class="h4 mb-3">{{ 'three_brs.ui.social_login.confirm_link_title'|trans }}</h1>
                        <p>{{ 'three_brs.ui.social_login.confirm_link_intro'|trans({'%email%': email, '%provider%': provider}) }}</p>

                        {% if error %}
                            <div class="alert alert-danger" data-test-three-brs-social-confirm-error>{{ error|trans }}</div>
                        {% endif %}

                        <form method="POST" action="{{ path('three_brs_shop_oauth_confirm_link') }}">
                            <div class="mb-3">
                                <label for="three_brs_oauth_confirm_password" class="form-label">
                                    {{ 'three_brs.ui.social_login.password_label'|trans }}
                                </label>
                                <input id="three_brs_oauth_confirm_password" name="_password" type="password" class="form-control" required autofocus data-test-three-brs-social-confirm-password>
                            </div>
                            <button type="submit" class="btn btn-primary w-100" data-test-three-brs-social-confirm-submit>
                                {{ 'three_brs.ui.social_login.confirm_and_link'|trans }}
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
