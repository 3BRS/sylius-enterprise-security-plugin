{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% import '@ThreeBRSSyliusEnterpriseSecurityPlugin/_shared/_macros.html.twig' as shared %}

{% block title %}{{ 'three_brs.ui.social_login.menu_item'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container mb-auto">
        <div class="row my-4">
            {{ include('@ThreeBRSSyliusEnterpriseSecurityPlugin/Shop/_account_breadcrumbs.html.twig', { active_label: 'three_brs.ui.social_login.menu_item' }) }}

            <div class="col-12 col-md-3 mb-4 mb-md-0">
                <div class="mb-3">
                    {{ knp_menu_render('sylius_shop.account', {'template': '@SyliusShop/account/menu/content.html.twig'}) }}
                </div>
            </div>
            <div class="col-12 col-md-9">
                <div class="mb-4">
                    <h1>{{ 'three_brs.ui.social_login.menu_item'|trans }}</h1>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <p class="text-muted mb-0">
                            {{ 'three_brs.ui.social_login.customer_intro'|trans }}
                        </p>
                    </div>
                </div>

                {% set user = app.user %}
                {% if user is not null %}
                    {% set links = three_brs_customer_social_links(user) %}
                    {% set providers = three_brs_social_providers('customer') %}
                    {% set linkable = providers|filter(p => links|filter(l => l.provider == p)|length == 0) %}

                    <div class="card" data-test-three-brs-social-links>
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h2 class="h5 mb-0">{{ 'three_brs.ui.social_login.link_accounts_title'|trans }}</h2>
                            {% if linkable|length > 0 %}
                                <div class="dropdown">
                                    <button type="button"
                                            class="btn btn-primary dropdown-toggle"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            data-test-three-brs-social-create>
                                        {{ 'sylius.ui.create'|trans }}
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        {% for provider in linkable %}
                                            <li>
                                                <a class="dropdown-item"
                                                   href="{{ path('three_brs_shop_oauth_initiate', {'provider': provider, 'intent': 'link'}) }}"
                                                   data-test-three-brs-social-link="{{ provider }}">
                                                    <i class="icon ti {{ shared.provider_icon_class(provider) }} me-2"></i>
                                                    {{ ('three_brs.ui.social_login.provider.' ~ provider)|trans }}
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% elseif links|length > 0 %}
                                <span class="text-secondary d-inline-flex align-items-center"
                                      data-test-three-brs-social-all-linked>
                                    <i class="icon ti ti-check me-1"></i>
                                    {{ 'three_brs.ui.social_login.all_linked'|trans }}
                                </span>
                            {% endif %}
                        </div>
                        <div class="card-body">
                            {% if links|length > 0 %}
                                <ul class="list-group list-group-flush">
                                    {% for link in links %}
                                        <li class="list-group-item px-0 py-3">
                                            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                                                <div class="d-flex align-items-center gap-3">
                                                    <span class="avatar bg-secondary-lt">
                                                        <i class="icon ti {{ shared.provider_icon_class(link.provider) }}"></i>
                                                    </span>
                                                    <div>
                                                        <div class="fw-semibold fs-5">
                                                            {{ ('three_brs.ui.social_login.provider.' ~ link.provider)|trans }}
                                                        </div>
                                                        {% if link.email %}
                                                            <div class="text-muted small">{{ link.email }}</div>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                <button type="button"
                                                        class="btn btn-outline-danger"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#three-brs-shop-social-unlink-modal-{{ link.provider }}"
                                                        data-test-three-brs-social-unlink="{{ link.provider }}">
                                                    {{ 'three_brs.ui.social_login.unlink'|trans }}
                                                </button>
                                            </div>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <div class="text-center py-4">
                                    <p class="text-muted mb-1 fw-semibold">{{ 'three_brs.ui.social_login.no_links_yet'|trans }}</p>
                                    <p class="text-muted small mb-0">{{ 'three_brs.ui.social_login.no_links_yet_subtitle'|trans }}</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {% if user is not null %}
        {% for link in links %}
            {{ shared.confirmation_modal(
                'three-brs-shop-social-unlink-modal-' ~ link.provider,
                'three_brs.ui.social_login.unlink'|trans,
                'three_brs.ui.social_login.unlink_confirm'|trans,
                path('three_brs_shop_social_account_unlink', {'provider': link.provider}),
                'three_brs_shop_social_unlink_' ~ link.provider,
                'three_brs.ui.social_login.unlink'|trans,
                'btn-danger',
            ) }}
        {% endfor %}
    {% endif %}
{% endblock %}
