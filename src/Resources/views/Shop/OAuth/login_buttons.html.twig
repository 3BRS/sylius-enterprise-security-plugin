{% set providers = three_brs_social_providers('customer') %}

{% if providers|length > 0 %}
    <div class="three-brs-social-login mt-3">
        {% if three_brs_password_login_enabled('customer') %}
            <div class="text-muted small text-center mb-2">
                {{ 'three_brs.ui.social_login.or_continue_with'|trans }}
            </div>
        {% endif %}
        <div class="d-flex flex-column gap-2">
            {% for provider in providers %}
                <a href="{{ path('three_brs_shop_oauth_initiate', {'provider': provider}) }}"
                   class="btn btn-outline-secondary w-100"
                   data-test-three-brs-social-login="{{ provider }}">
                    {{ ('three_brs.ui.social_login.provider.' ~ provider)|trans }}
                </a>
            {% endfor %}
        </div>
    </div>
{% endif %}
