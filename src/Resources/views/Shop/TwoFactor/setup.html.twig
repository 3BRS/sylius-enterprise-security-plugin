{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'three_brs.ui.two_factor.setup_title'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container mb-auto">
        <div class="row my-4">
            {{ include('@ThreeBRSSyliusEnterpriseSecurityPlugin/Shop/_account_breadcrumbs.html.twig', { active_label: 'three_brs.ui.two_factor.setup_title' }) }}

            <div class="col-12 col-md-3 mb-4 mb-md-0">
                <div class="mb-3">
                    {{ knp_menu_render('sylius_shop.account', {'template': '@SyliusShop/account/menu/content.html.twig'}) }}
                </div>
            </div>
            <div class="col-12 col-md-9">
                <div class="mb-4">
                    <h1>{{ 'three_brs.ui.two_factor.setup_title'|trans }}</h1>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <p class="text-muted mb-0">
                            {{ 'three_brs.ui.two_factor.setup_description'|trans }}
                        </p>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-12 col-md-4 text-center mb-3 mb-md-0">
                                <img src="{{ qr_data_uri }}" alt="{{ 'three_brs.ui.two_factor.setup_title'|trans }}" class="img-fluid border rounded p-2 bg-white" data-test-two-factor-qr>
                            </div>
                            <div class="col-12 col-md-8">
                                <p class="mb-2">{{ 'three_brs.ui.two_factor.manual_code'|trans }}</p>
                                <div class="three-brs-copy-field d-block p-3 bg-light border rounded text-break position-relative font-monospace mb-3"
                                     role="button"
                                     tabindex="0"
                                     title="{{ 'three_brs.ui.copy'|trans }}"
                                     aria-label="{{ 'three_brs.ui.copy'|trans }}"
                                     data-three-brs-copy-text="{{ secret }}"
                                     data-test-two-factor-secret>
                                    <span class="three-brs-copy-field-value">{{ secret }}</span>
                                    <span class="three-brs-copy-field-icon" aria-hidden="true">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 8m0 2a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2z" /><path d="M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2" /></svg>
                                    </span>
                                </div>

                                {% form_theme form '@SyliusShop/form/theme.html.twig' %}
                                {{ form_start(form, { action: path('three_brs_shop_two_factor_setup'), method: 'POST', attr: { novalidate: 'novalidate' } }) }}
                                    <div class="mb-3 text-center">
                                        {{ form_label(form.code) }}
                                        {{ form_widget(form.code) }}
                                        {{ form_errors(form.code) }}
                                    </div>
                                    <div class="mt-3 text-center">
                                        <button type="submit" class="btn btn-primary" data-test-two-factor-verify>
                                            {{ 'three_brs.ui.two_factor.verify_and_enable'|trans }}
                                        </button>
                                    </div>
                                {{ form_end(form) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <link rel="stylesheet" href="{{ asset('bundles/threebrssyliusenterprisesecurityplugin/css/copy_field.css') }}">
    <script src="{{ asset('bundles/threebrssyliusenterprisesecurityplugin/js/copy_field.js') }}"></script>

    <script>
        (function () {
            document.querySelectorAll('[data-totp-code]').forEach(function (input) {
                input.addEventListener('input', function () {
                    var digits = input.value.replace(/\D/g, '').slice(0, 6);
                    input.value = digits.length > 3 ? digits.slice(0, 3) + '-' + digits.slice(3) : digits;
                });
                var form = input.closest('form');
                if (form) {
                    form.addEventListener('submit', function () {
                        input.value = input.value.replace(/-/g, '');
                    });
                }
            });
        })();
    </script>
{% endblock %}
