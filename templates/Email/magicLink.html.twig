{% block subject %}
    {{ 'three_brs.emails.magic_link.subject'|trans }}
{% endblock %}

{% block body %}
    <div style="font-family: sans-serif; background: #eee; padding-top: 30px; padding-bottom: 30px; font-size: 16px; color: #333; line-height: 1.5">
        <div style="max-width: 600px; margin: 20px auto;">
            <div style="background: #fff; padding: 40px 30px;">
                <div style="font-size: 24px; margin-bottom: 20px;">
                    {{ 'three_brs.emails.magic_link.title'|trans }}
                </div>

                <p>{{ 'three_brs.emails.magic_link.intro'|trans }}</p>

                <div style="text-align: center; margin: 30px 0;">
                    <a href="{{ magicLinkUrl }}" style="display: inline-block; background: #28a745; padding: 14px 24px; color: #fff; text-decoration: none; border-radius: 4px;">
                        {{ 'three_brs.emails.magic_link.button'|trans }}
                    </a>
                </div>

                <p style="color: #666; font-size: 14px;">
                    {{ 'three_brs.emails.magic_link.expires_in'|trans({'%minutes%': expirationMinutes}) }}
                </p>

                <p style="color: #666; font-size: 14px;">
                    {{ 'three_brs.emails.magic_link.ignore_if_not_requested'|trans }}
                </p>
            </div>
        </div>
    </div>
{% endblock %}
