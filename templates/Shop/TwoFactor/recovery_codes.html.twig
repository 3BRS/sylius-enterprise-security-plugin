{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'three_brs.ui.two_factor.recovery_codes_title'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container mb-auto">
        <div class="row my-4">
            {{ include('@ThreeBRSSyliusEnterpriseSecurityPlugin/Shop/_account_breadcrumbs.html.twig', { active_label: 'three_brs.ui.two_factor.recovery_codes_title' }) }}

            <div class="col-12 col-md-3 mb-4 mb-md-0">
                <div class="mb-3">
                    {{ knp_menu_render('sylius_shop.account', {'template': '@SyliusShop/account/menu/content.html.twig'}) }}
                </div>
            </div>
            <div class="col-12 col-md-9">
                <div class="mb-4">
                    <h1>{{ 'three_brs.ui.two_factor.recovery_codes_title'|trans }}</h1>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <div class="alert alert-warning mb-4">
                            {{ 'three_brs.ui.two_factor.recovery_codes_warning'|trans }}
                        </div>

                        <ul class="list-group mb-3" data-test-two-factor-recovery-codes>
                            {% for code in codes %}
                                <li class="list-group-item font-monospace text-center" data-test-recovery-code>{{ code }}</li>
                            {% endfor %}
                        </ul>

                        <div class="three-brs-copy-field d-inline-flex align-items-center p-2 px-3 bg-light border rounded position-relative mb-4"
                             role="button"
                             tabindex="0"
                             title="{{ 'three_brs.ui.two_factor.copy_all_recovery_codes'|trans }}"
                             aria-label="{{ 'three_brs.ui.two_factor.copy_all_recovery_codes'|trans }}"
                             data-three-brs-copy-text="{{ codes|join("\n") }}"
                             data-test-copy-all-recovery-codes>
                            <span class="three-brs-copy-field-value">{{ 'three_brs.ui.two_factor.copy_all_recovery_codes'|trans }}</span>
                            <span class="three-brs-copy-field-icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 8m0 2a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2z" /><path d="M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2" /></svg>
                            </span>
                        </div>

                        <a href="{{ path('three_brs_shop_two_factor_setup') }}" class="btn btn-primary col-12 col-md-auto">
                            {{ 'three_brs.ui.two_factor.recovery_codes_acknowledged'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <link rel="stylesheet" href="{{ asset('bundles/threebrssyliusenterprisesecurityplugin/css/copy_field.css') }}">
    <script src="{{ asset('bundles/threebrssyliusenterprisesecurityplugin/js/copy_field.js') }}"></script>
{% endblock %}
