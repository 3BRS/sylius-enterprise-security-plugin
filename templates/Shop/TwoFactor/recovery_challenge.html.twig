{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'three_brs.ui.two_factor.recovery_challenge_title'|trans }} | {{ parent() }}{% endblock %}

{#
 # Laid out like the shared challenge page this is reached from
 # (TwoFactor/challenge.html.twig), so the two halves of the same sign-in step
 # look alike: Bootstrap utilities the shop ships, and the whole body replaced
 # rather than the content slot, which keeps the storefront navigation out of a
 # step the customer has not finished yet.
 #}
{% block body %}
    <div class="d-flex align-items-center justify-content-center min-vh-100 py-4">
        <div class="container" style="max-width: 30rem;">
            <div class="card shadow-sm" data-test-two-factor-recovery-challenge>
                <div class="card-body p-4">
                    <h2 class="h2 text-center mb-2">{{ 'three_brs.ui.two_factor.recovery_challenge_title'|trans }}</h2>
                    <p class="text-muted text-center mb-4">{{ 'three_brs.ui.two_factor.recovery_challenge_intro'|trans }}</p>

                    {% if error %}
                        <div class="alert alert-danger" data-test-two-factor-recovery-error>
                            {{ error|trans }}
                        </div>
                    {% endif %}

                    <form method="post">
                        <div class="mb-3">
                            <label for="_recovery_code" class="form-label">{{ 'three_brs.ui.two_factor.recovery_code'|trans }}</label>
                            <input
                                id="_recovery_code"
                                type="text"
                                class="form-control"
                                name="_recovery_code"
                                data-test-two-factor-recovery-code
                                autocomplete="one-time-code"
                                autofocus
                            />
                        </div>

                        <button type="submit" class="btn btn-primary w-100" data-test-two-factor-recovery-submit>
                            {{ 'three_brs.ui.two_factor.verify_recovery_code'|trans }}
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <a href="{{ path('three_brs_shop_two_factor_challenge') }}" class="text-muted" data-test-two-factor-challenge-back>
                            {{ 'three_brs.ui.two_factor.back_to_challenge'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
