{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% import '@ThreeBRSSyliusEnterpriseSecurityPlugin/_shared/_macros.html.twig' as shared %}

{% block title %}{{ 'three_brs.ui.passkey.menu_item'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container mb-auto">
        <div class="row my-4">
            {{ include('@ThreeBRSSyliusEnterpriseSecurityPlugin/Shop/_account_breadcrumbs.html.twig', { active_label: 'three_brs.ui.passkey.title' }) }}

            <div class="col-12 col-md-3 mb-4 mb-md-0">
                <div class="mb-3">
                    {{ knp_menu_render('sylius_shop.account', {'template': '@SyliusShop/account/menu/content.html.twig'}) }}
                </div>
            </div>
            <div class="col-12 col-md-9">
                <div class="mb-4">
                    <h1>{{ 'three_brs.ui.passkey.title'|trans }}</h1>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <p class="text-muted mb-0">
                            {{ 'three_brs.ui.passkey.intro'|trans }}
                        </p>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h2 class="h5 mb-0">{{ 'three_brs.ui.passkey.your_passkeys'|trans }}</h2>
                        <button type="button"
                                class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#three-brs-passkey-create-modal"
                                id="three_brs_passkey_create_trigger">
                            {{ 'three_brs.ui.passkey.register'|trans }}
                        </button>
                    </div>
                    <div class="card-body">
                        <p id="three_brs_passkey_unsupported_notice" class="text-warning small mb-3 d-none">
                            {{ 'three_brs.ui.passkey.browser_unsupported'|trans }}
                        </p>
                        {% if credentials|length > 0 %}
                            <ul class="list-group list-group-flush" data-test-three-brs-passkey-list>
                                {% for credential in credentials %}
                                    <li class="list-group-item px-0 py-3">
                                        <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                                            <div>
                                                <div class="fw-semibold fs-5">{{ credential.label }}</div>
                                                <div class="text-muted small">
                                                    {{ 'three_brs.ui.passkey.added'|trans }}: {{ credential.createdAt|date('Y-m-d H:i') }}
                                                    {% if credential.lastUsedAt %}
                                                        · {{ 'three_brs.ui.passkey.last_used'|trans }}: {{ credential.lastUsedAt|date('Y-m-d H:i') }}
                                                    {% endif %}
                                                </div>
                                            </div>
                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#three-brs-shop-passkey-delete-modal-{{ credential.id }}"
                                                    data-test-three-brs-passkey-delete="{{ credential.id }}">
                                                {{ 'three_brs.ui.passkey.delete'|trans }}
                                            </button>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <div class="text-center py-4">
                                <p class="text-muted mb-1 fw-semibold">{{ 'three_brs.ui.passkey.none_yet'|trans }}</p>
                                <p class="text-muted small mb-0">{{ 'three_brs.ui.passkey.none_yet_subtitle'|trans }}</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="three-brs-passkey-create-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5">{{ 'three_brs.ui.passkey.name_your_passkey'|trans }}</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label for="three_brs_passkey_label_input" class="form-label">
                        {{ 'three_brs.ui.passkey.label_field_label'|trans }}
                    </label>
                    <input type="text"
                           class="form-control"
                           id="three_brs_passkey_label_input"
                           placeholder="{{ 'three_brs.ui.passkey.label_placeholder'|trans }}"
                           maxlength="64">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">
                        {{ 'three_brs.ui.passkey.cancel'|trans }}
                    </button>
                    <button type="button"
                            class="btn btn-primary"
                            id="three_brs_passkey_register_button"
                            data-test-three-brs-passkey-register
                            data-options-url="{{ path('three_brs_shop_passkey_register_options') }}"
                            data-verify-url="{{ path('three_brs_shop_passkey_register_verify') }}"
                            data-list-url="{{ path('three_brs_shop_passkey_index') }}"
                            data-cancelled-message="{{ 'three_brs.ui.passkey.registration_cancelled'|trans }}"
                            data-error-message="{{ 'three_brs.ui.passkey.registration_failed'|trans }}"
                            data-modal-target="#three-brs-passkey-create-modal">
                        {{ 'three_brs.ui.passkey.submit'|trans }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    {% for credential in credentials %}
        {{ shared.confirmation_modal(
            'three-brs-shop-passkey-delete-modal-' ~ credential.id,
            'three_brs.ui.passkey.delete'|trans,
            'three_brs.ui.passkey.delete_confirm'|trans({'%label%': credential.label}),
            path('three_brs_shop_passkey_delete', {'id': credential.id}),
            'three_brs_shop_passkey_delete',
            'three_brs.ui.passkey.delete'|trans,
            'btn-danger',
        ) }}
    {% endfor %}

    <script src="{{ asset('bundles/threebrssyliusenterprisesecurityplugin/js/passkey.js') }}"></script>
{% endblock %}
